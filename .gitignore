# Dependencies
node_modules/

# Production build output
dist/

# Generated from package.json before dev/build so the static settings page
# always displays the packaged Scout release version.
pages/settings/version.js

# `tbf dev` working tree. user-data/ is a full browser profile: history,
# cookies, local storage and cached credentials for every site opened while
# developing. Never commit it.
.tbf-dev/

# Vendored upstream uBlock Origin build (16MB), fetched by
# scripts/fetch-ublock.mjs on npm install. Never commit it.
extensions/ublock/

# Probe and Python helper output. These were previously covered by the TBF
# repository's root ignore rules.
.scout-probe/
__pycache__/
*.pyc

# Editor and OS noise
.DS_Store
*.log

# Local drafts for documenting and promoting Scout on X. These posts and their
# screenshots are working material and should not be published with the source.
x-posts/
